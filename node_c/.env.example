# Node C — Environment Variables
# Copy this file to .env and update values as needed

# HTTP server port
PORT=3000

# MQTT broker URL (runs in-process on Node C, so localhost)
MQTT_BROKER_URL=mqtt://localhost:1883

# Redis connection URL
REDIS_URL=redis://localhost:6379

# CORS origin (set to your dashboard URL in production, e.g. http://192.168.1.100:3000)
# Leave unset to disable CORS (same-origin only)
CORS_ORIGIN=

# Smart Decision Engine thresholds (optional — defaults shown)
# AC_TEMP_THRESHOLD=25.5
# MOTION_TIMEOUT_MS=10000
# LED_POWER_WATTS=50
# AC_POWER_WATTS=750
# MIN_SAVING_INTERVAL_MS=60000
